{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "challenge": {
      "type": "string"
    },
    "approach": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "year",
    "summary",
    "challenge",
    "approach",
    "outcome"
  ]
}