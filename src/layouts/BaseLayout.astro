---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = site.seoTitle,
  description = site.seoDescription,
  image = site.seoImage
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const siteOrigin = Astro.site ?? Astro.url.origin;

const canonicalURL = new URL(
  Astro.url.pathname,
  siteOrigin
);

const getMediaUrl = (path?: string) => {
  if (!path) return '';

  if (
    path.startsWith('http://') ||
    path.startsWith('https://')
  ) {
    return path;
  }

  const cleanPath = path
    .replace(/^\/brian-portfolio\//, '')
    .replace(/^\//, '');

  return new URL(
    `${base}${cleanPath}`,
    siteOrigin
  ).toString();
};

const canonicalUrlString = canonicalURL.toString();
const socialImage = getMediaUrl(image);
const homeUrl = new URL(base, siteOrigin).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      url: homeUrl,
      name: `${site.name} Portfolio`,
      description: site.seoDescription,
      inLanguage: 'en'
    },
    {
      '@type': 'Person',
      '@id': `${homeUrl}#person`,
      name: site.name,
      url: homeUrl,
      jobTitle: site.role,
      description: site.seoDescription,
      sameAs: [
        site.linkedin,
        site.github
      ].filter(Boolean)
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#090a0d" />

    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}favicon.svg`}
    />

    <link
      rel="manifest"
      href={`${base}site.webmanifest`}
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large"
    />

    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.name} />

    <link
      rel="canonical"
      href={canonicalUrlString}
    />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrlString} />

    {
      socialImage && (
        <>
          <meta
            property="og:image"
            content={socialImage}
          />

          <meta
            property="og:image:alt"
            content={`${title} social sharing image`}
          />
        </>
      )
    }

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    {
      socialImage && (
        <meta
          name="twitter:image"
          content={socialImage}
        />
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

    <ClientRouter />
  </head>

  <body>

    <div
      class="progress"
      aria-hidden="true"
    ></div>

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      const updateProgress = () => {
        const progress =
          document.querySelector<HTMLElement>('.progress');

        if (!progress) return;

        const availableScroll =
          document.documentElement.scrollHeight -
          window.innerHeight;

        const percentage =
          availableScroll > 0
            ? window.scrollY / availableScroll
            : 0;

        progress.style.transform =
          `scaleX(${Math.min(Math.max(percentage, 0), 1)})`;
      };

      const closeMobileMenu = () => {
        const menuButton =
          document.querySelector<HTMLButtonElement>('.menu-btn');

        const mobileNavigation =
          document.querySelector<HTMLElement>('.mobile-nav');

        mobileNavigation?.classList.remove('open');
        document.body.classList.remove('menu-open');

        menuButton?.setAttribute(
          'aria-expanded',
          'false'
        );
      };

      const initialiseMobileMenu = () => {
        const menuButton =
          document.querySelector<HTMLButtonElement>('.menu-btn');

        const mobileNavigation =
          document.querySelector<HTMLElement>('.mobile-nav');

        if (
          !menuButton ||
          !mobileNavigation ||
          menuButton.dataset.menuReady === 'true'
        ) {
          return;
        }

        menuButton.dataset.menuReady = 'true';

        menuButton.addEventListener('click', () => {
          const isOpen =
            mobileNavigation.classList.toggle('open');

          document.body.classList.toggle(
            'menu-open',
            isOpen
          );

          menuButton.setAttribute(
            'aria-expanded',
            String(isOpen)
          );
        });

        mobileNavigation
          .querySelectorAll<HTMLAnchorElement>('a')
          .forEach((link) => {
            link.addEventListener(
              'click',
              closeMobileMenu
            );
          });
      };


      document.addEventListener(
        'astro:page-load',
        () => {
          initialiseMobileMenu();
          updateProgress();
        }
      );

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMobileMenu();
        }
      });

      window.addEventListener(
        'scroll',
        updateProgress,
        { passive: true }
      );

      window.addEventListener(
        'resize',
        updateProgress,
        { passive: true }
      );

      initialiseMobileMenu();
      updateProgress();
    </script>
  </body>
</html>
