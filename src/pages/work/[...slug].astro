---
import Base from '../../layouts/BaseLayout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const p=await getCollection('projects');return p.map(x=>({params:{slug:x.id},props:{project:x}}))}const {project}=Astro.props;const {Content}=await render(project);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<Base title={`${project.data.title} | Brian Fernandes`}><section class="wrap"><a href={`${base}#work`}>← Back to work</a><p class="eyebrow" style="margin-top:70px">{project.data.category}</p><h1 class="page-title">{project.data.title}</h1><p class="body-copy">{project.data.summary}</p></section><section class="wrap"><div class="project-art"></div></section><section class="wrap case-grid"><div class="case"><b>01</b><h2>Challenge</h2><p class="body-copy">{project.data.challenge}</p></div><div class="case"><b>02</b><h2>Approach</h2><p class="body-copy">{project.data.approach}</p></div><div class="case"><b>03</b><h2>Outcome</h2><p class="body-copy">{project.data.outcome}</p></div></section><section class="wrap"><Content/></section></Base>
