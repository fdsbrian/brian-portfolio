<script define:vars={{ galleryItems }}>
  (() => {
    const dialog = document.getElementById('gallery-lightbox');
    const stage = document.querySelector('.gallery-lightbox-stage');
    const image = document.getElementById('gallery-lightbox-image');
    const caption = document.getElementById('gallery-lightbox-caption');
    const counter = document.getElementById('gallery-lightbox-counter');
    const previous = document.querySelector('.gallery-lightbox-prev');
    const next = document.querySelector('.gallery-lightbox-next');
    const close = document.querySelector('.gallery-lightbox-close');
    const zoomIn = document.querySelector('.gallery-lightbox-zoom-in');
    const zoomOut = document.querySelector('.gallery-lightbox-zoom-out');
    const resetButton = document.querySelector('.gallery-lightbox-reset');
    const triggers = document.querySelectorAll('.case-study-gallery-image');

    if (
      !(dialog instanceof HTMLDialogElement) ||
      !(stage instanceof HTMLElement) ||
      !(image instanceof HTMLImageElement) ||
      !(caption instanceof HTMLElement) ||
      !(counter instanceof HTMLElement) ||
      galleryItems.length === 0
    ) {
      return;
    }

    let current = 0;
    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let startTranslateX = 0;
    let startTranslateY = 0;

    let swipePointerId = null;
    let swipeStartX = 0;
    let swipeStartY = 0;
    let swipeCurrentX = 0;
    let swipeCurrentY = 0;
    let swipeStartedAt = 0;

    const swipeDistanceThreshold = 55;
    const swipeVelocityThreshold = 0.35;
    const swipeVerticalTolerance = 80;

    const activeTouchPointers = new Map();
    let pinchStartDistance = 0;
    let pinchStartScale = 1;
    let pinchCenterX = 0;
    let pinchCenterY = 0;
    let lastTapAt = 0;
    let lastTapX = 0;
    let lastTapY = 0;

    const doubleTapDelay = 320;
    const doubleTapDistance = 32;

    const getPointerDistance = () => {
      const points = Array.from(activeTouchPointers.values());

      if (points.length < 2) {
        return 0;
      }

      return Math.hypot(
        points[1].x - points[0].x,
        points[1].y - points[0].y
      );
    };

    const getPointerCenter = () => {
      const points = Array.from(activeTouchPointers.values());

      if (points.length < 2) {
        return { x: 0, y: 0 };
      }

      return {
        x: (points[0].x + points[1].x) / 2,
        y: (points[0].y + points[1].y) / 2
      };
    };


    const minimumScale = 1;
    const maximumScale = 4;
    const zoomStep = 0.5;

    const clamp = (value, minimum, maximum) =>
      Math.min(Math.max(value, minimum), maximum);

    const updateTransform = () => {
      image.style.transform =
        `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;

      stage.classList.toggle('is-zoomed', scale > 1);
      resetButton.textContent = `${Math.round(scale * 100)}%`;

      const navigationDisabled = scale > 1;

      if (previous instanceof HTMLButtonElement) {
        previous.disabled = navigationDisabled;
      }

      if (next instanceof HTMLButtonElement) {
        next.disabled = navigationDisabled;
      }
    };

    const resetView = () => {
      scale = 1;
      translateX = 0;
      translateY = 0;
      isDragging = false;
      stage.classList.remove('is-dragging');
      stage.classList.remove('is-swiping');
      swipePointerId = null;
      updateTransform();

      activeTouchPointers.clear();
      pinchStartDistance = 0;
      pinchStartScale = 1;
      pinchCenterX = 0;
      pinchCenterY = 0;
      lastTapAt = 0;
    };

    const setScale = (nextScale) => {
      scale = clamp(
        Number(nextScale.toFixed(2)),
        minimumScale,
        maximumScale
      );

      if (scale === 1) {
        translateX = 0;
        translateY = 0;
      }

      updateTransform();
    };

    const update = () => {
      const item = galleryItems[current];

      resetView();
      image.src = item.src;
      image.alt = item.alt;
      caption.textContent = item.caption || '';
      counter.textContent = `${current + 1} / ${galleryItems.length}`;
    };

    const showPrevious = () => {
      if (scale > 1) return;

      current =
        (current - 1 + galleryItems.length) % galleryItems.length;

      update();
    };

    const showNext = () => {
      if (scale > 1) return;

      current = (current + 1) % galleryItems.length;
      update();
    };

    triggers.forEach((button) => {
      button.addEventListener('click', () => {
        current = Number(button.dataset.galleryIndex);
        update();
        dialog.showModal();
        document.body.classList.add('lightbox-open');
      });
    });

    previous?.addEventListener('click', showPrevious);
    next?.addEventListener('click', showNext);

    close?.addEventListener('click', () => {
      dialog.close();
    });

    zoomIn?.addEventListener('click', () => {
      setScale(scale + zoomStep);
    });

    zoomOut?.addEventListener('click', () => {
      setScale(scale - zoomStep);
    });

    resetButton?.addEventListener('click', resetView);

    stage.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();

        const direction = event.deltaY < 0 ? zoomStep : -zoomStep;
        setScale(scale + direction);
      },
      { passive: false }
    );

    stage.addEventListener('pointerdown', (event) => {

      if (event.pointerType === 'touch') {
        activeTouchPointers.set(event.pointerId, {
          x: event.clientX,
          y: event.clientY
        });

        stage.setPointerCapture(event.pointerId);

        if (activeTouchPointers.size === 2) {
          pinchStartDistance = getPointerDistance();
          pinchStartScale = scale;

          const center = getPointerCenter();
          pinchCenterX = center.x;
          pinchCenterY = center.y;

          swipePointerId = null;
          isDragging = false;
          stage.classList.remove('is-swiping');
          stage.classList.remove('is-dragging');
          return;
        }
      }


      if (scale > 1) {
        isDragging = true;
        dragStartX = event.clientX;
        dragStartY = event.clientY;
        startTranslateX = translateX;
        startTranslateY = translateY;

        stage.classList.add('is-dragging');
        stage.setPointerCapture(event.pointerId);
        return;
      }

      if (
        event.pointerType !== 'touch' &&
        event.pointerType !== 'pen'
      ) {
        return;
      }

      swipePointerId = event.pointerId;
      swipeStartX = event.clientX;
      swipeStartY = event.clientY;
      swipeCurrentX = event.clientX;
      swipeCurrentY = event.clientY;
      swipeStartedAt = performance.now();

      stage.classList.add('is-swiping');
      stage.setPointerCapture(event.pointerId);
    });


    stage.addEventListener('pointermove', (event) => {

      if (
        event.pointerType === 'touch' &&
        activeTouchPointers.has(event.pointerId)
      ) {
        activeTouchPointers.set(event.pointerId, {
          x: event.clientX,
          y: event.clientY
        });

        if (activeTouchPointers.size === 2) {
          event.preventDefault();

          const currentDistance = getPointerDistance();

          if (pinchStartDistance > 0) {
            const pinchRatio =
              currentDistance / pinchStartDistance;

            scale = clamp(
              pinchStartScale * pinchRatio,
              minimumScale,
              maximumScale
            );

            const center = getPointerCenter();

            translateX +=
              (center.x - pinchCenterX) * 0.45;

            translateY +=
              (center.y - pinchCenterY) * 0.45;

            pinchCenterX = center.x;
            pinchCenterY = center.y;

            if (scale === 1) {
              translateX = 0;
              translateY = 0;
            }

            updateTransform();
          }

          return;
        }
      }


      if (isDragging && scale > 1) {
        translateX =
          startTranslateX + event.clientX - dragStartX;

        translateY =
          startTranslateY + event.clientY - dragStartY;

        updateTransform();
        return;
      }

      if (
        scale !== 1 ||
        swipePointerId !== event.pointerId
      ) {
        return;
      }

      swipeCurrentX = event.clientX;
      swipeCurrentY = event.clientY;

      const deltaX = swipeCurrentX - swipeStartX;
      const deltaY = swipeCurrentY - swipeStartY;

      if (Math.abs(deltaX) > Math.abs(deltaY)) {
        event.preventDefault();

        const previewOffset = Math.max(
          Math.min(deltaX * 0.22, 42),
          -42
        );

        image.style.transform =
          `translate3d(${previewOffset}px, 0, 0) scale(0.985)`;
      }
    });


    const stopDragging = (event) => {
      if (!isDragging) return;

      isDragging = false;
      stage.classList.remove('is-dragging');

      if (stage.hasPointerCapture(event.pointerId)) {
        stage.releasePointerCapture(event.pointerId);
      }
    };

    const finishPointerInteraction = (event, cancelled = false) => {
      if (isDragging) {
        isDragging = false;
        stage.classList.remove('is-dragging');

        if (stage.hasPointerCapture(event.pointerId)) {
          stage.releasePointerCapture(event.pointerId);
        }

        return;
      }

      if (swipePointerId !== event.pointerId) {
        return;
      }

      const deltaX = swipeCurrentX - swipeStartX;
      const deltaY = swipeCurrentY - swipeStartY;
      const elapsed = Math.max(
        performance.now() - swipeStartedAt,
        1
      );
      const velocity = Math.abs(deltaX) / elapsed;

      const isHorizontal =
        Math.abs(deltaX) > Math.abs(deltaY);

      const isWithinVerticalTolerance =
        Math.abs(deltaY) < swipeVerticalTolerance;

      const passedDistance =
        Math.abs(deltaX) >= swipeDistanceThreshold;

      const passedVelocity =
        velocity >= swipeVelocityThreshold &&
        Math.abs(deltaX) >= 35;

      stage.classList.remove('is-swiping');

      if (stage.hasPointerCapture(event.pointerId)) {
        stage.releasePointerCapture(event.pointerId);
      }

      swipePointerId = null;
      swipeStartX = 0;
      swipeStartY = 0;
      swipeCurrentX = 0;
      swipeCurrentY = 0;
      swipeStartedAt = 0;

      image.style.transform =
        'translate3d(0, 0, 0) scale(1)';

      if (
        cancelled ||
        !isHorizontal ||
        !isWithinVerticalTolerance ||
        (!passedDistance && !passedVelocity)
      ) {
        return;
      }

      if (deltaX < 0) {
        showNext();
      } else {
        showPrevious();
      }
    };

    stage.addEventListener('pointerup', (event) => {
      if (event.pointerType === 'touch') {
        activeTouchPointers.delete(event.pointerId);

        if (activeTouchPointers.size < 2) {
          pinchStartDistance = 0;
          pinchStartScale = scale;
        }
      }

      finishPointerInteraction(event);
    });

    stage.addEventListener('pointercancel', (event) => {
      activeTouchPointers.delete(event.pointerId);

      if (activeTouchPointers.size < 2) {
        pinchStartDistance = 0;
      }

      finishPointerInteraction(event, true);
    });

    stage.addEventListener('pointerup', (event) => {
      if (event.pointerType !== 'touch') {
        return;
      }

      const now = performance.now();
      const elapsed = now - lastTapAt;
      const distance = Math.hypot(
        event.clientX - lastTapX,
        event.clientY - lastTapY
      );

      if (
        elapsed > 0 &&
        elapsed <= doubleTapDelay &&
        distance <= doubleTapDistance &&
        scale > 1
      ) {
        event.preventDefault();
        resetView();
        lastTapAt = 0;
        return;
      }

      lastTapAt = now;
      lastTapX = event.clientX;
      lastTapY = event.clientY;
    });

    stage.addEventListener('dblclick', () => {
      resetView();
    });


    stage.addEventListener('dblclick', () => {
      resetView();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.addEventListener('close', () => {
      resetView();
      document.body.classList.remove('lightbox-open');
    });

    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;

      if (event.key === 'Escape') {
        dialog.close();
      }

      if (event.key === 'ArrowRight') {
        showNext();
      }

      if (event.key === 'ArrowLeft') {
        showPrevious();
      }

      if (event.key === '+' || event.key === '=') {
        setScale(scale + zoomStep);
      }

      if (event.key === '-' || event.key === '_') {
        setScale(scale - zoomStep);
      }

      if (event.key === '0') {
        resetView();
      }
    });
  })();
