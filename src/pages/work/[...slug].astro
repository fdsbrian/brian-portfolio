    `${project.data.title} | Brian Fernandes`
  }
  description={
    project.data.seoDescription?.trim() ||
    project.data.summary
  }
  image={
    project.data.seoImage ||
    project.data.cover
  }
>
<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbData)}
></script>

  <article class="case-study">

<section class="case-study-visual">
  {
    hasProjectHeroMedia ? (
    

<figure class="case-study-cover case-study-cover--media">
