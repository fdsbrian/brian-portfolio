---
import Base from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

  return projects.map((project) => ({
    params: {
      slug: project.id
    },
    props: {
      project
    }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const currentProjectIndex = allProjects.findIndex(
  (item) => item.id === project.id
);

const previousProject =
  allProjects[
    (currentProjectIndex - 1 + allProjects.length) %
      allProjects.length
  ];

const nextProject =
  allProjects[
    (currentProjectIndex + 1) %
      allProjects.length
  ];

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const getMediaUrl = (path?: string) => {
  if (!path) {
    return '';
  }

if (
  path.startsWith('http://') ||
  path.startsWith('https://')
) {
  return path;
}

const cleanPath = path
  .replace(/^\/brian-portfolio\//, '')
  .replace(/^\//, '');

return `${base}${cleanPath}`;
};

const coverUrl = getMediaUrl(project.data.cover);
---

<Base
  title={`${project.data.title} | Brian Fernandes`}
  description={project.data.summary}
  image={project.data.cover}
>
  <article class="case-study">
    <header class="wrap case-study-header">
      <a href={`${base}#work`}>
        <span aria-hidden="true">←</span>
        Back to work
      </a>

  <div class="case-study-heading">
    <div class="case-study-heading-main">
      <p class="eyebrow">
        {project.data.category}
      </p>

      <h1 class="page-title">
        {project.data.title}
      </h1>
    </div>

    <p class="case-study-summary">
      {project.data.summary}
    </p>
  </div>

  <dl class="case-study-facts">
    {
      project.data.industry && (
        <div>
          <dt>Industry</dt>
          <dd>{project.data.industry}</dd>
        </div>
      )
    }

    {
      project.data.role && (
        <div>
          <dt>Role</dt>
          <dd>{project.data.role}</dd>
        </div>
      )
    }

    {
      project.data.client && (
        <div>
          <dt>Client</dt>
          <dd>{project.data.client}</dd>
        </div>
      )
    }

    <div>
      <dt>Year</dt>
      <dd>{project.data.year}</dd>
    </div>
  </dl>
</header>

<section class="wrap case-study-visual">
  {
    coverUrl ? (
      <figure class="case-study-cover">
        <img
          src={coverUrl}
          alt={project.data.coverAlt || project.data.title}
          loading="eager"
          decoding="async"
          >
      </figure>
    ) : (
      <div
        class="case-study-cover case-study-cover-placeholder"
        aria-label={`${project.data.title} cover placeholder`}
      >
        <span aria-hidden="true">
          {String(project.data.order).padStart(2, '0')}
        </span>

        <small>{project.data.category}</small>
      </div>
    )
  }
</section>

{
  project.data.results.length > 0 && (
    <section
      class="wrap case-study-results"
      aria-labelledby="project-results-title"
    >
      <div class="case-study-results-heading">
        <p class="eyebrow">Results / Impact</p>

        <h2 id="project-results-title">
          Measurable outcomes.
        </h2>
      </div>

      <div class="case-study-results-grid">
        {
          project.data.results.map((result, index) => (
            <article class="case-study-result">
              <span
                class="case-study-result-index"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>

              <strong>{result.value}</strong>

              <h3>{result.label}</h3>

              {
                result.description && (
                  <p>{result.description}</p>
                )
              }
            </article>
          ))
        }
      </div>
    </section>
  )
}

<section class="wrap case-study-overview">
  <article class="case-study-block">
    <span class="case-study-number" aria-hidden="true">
      01
    </span>

    <h2>Challenge</h2>

    <p>{project.data.challenge}</p>
  </article>

  <article class="case-study-block">
    <span class="case-study-number" aria-hidden="true">
      02
    </span>

    <h2>Approach</h2>

    <p>{project.data.approach}</p>
  </article>

  <article class="case-study-block">
    <span class="case-study-number" aria-hidden="true">
      03
    </span>

    <h2>Outcome</h2>

    <p>{project.data.outcome}</p>
  </article>
</section>

{
  project.data.gallery.length > 0 && (
    <section
      class="wrap case-study-gallery"
      aria-labelledby="project-gallery-title"
    >
      <div class="case-study-gallery-heading">
        <p class="eyebrow">Selected screens</p>

        <h2 id="project-gallery-title">
          Project gallery
        </h2>
      </div>

      <div class="case-study-gallery-grid">
        {
          project.data.gallery.map((item, index) => (
            <figure
              class:list={[
                'case-study-gallery-item',
                `case-study-gallery-item--${item.layout}`
              ]}
            >
              <div class="case-study-gallery-image">
                <img
                  src={getMediaUrl(item.image)}
                  alt={item.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>

              {
                item.caption && (
                  <figcaption>
                    <span aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>

                    <p>{item.caption}</p>
                  </figcaption>
                )
              }
            </figure>
          ))
        }
      </div>
    </section>
  )
}

<section class="wrap case-study-content">
  <div class="case-study-content-label">
    <p class="eyebrow">Project narrative</p>
  </div>

  <div class="case-study-rich-text">
    <Content />
  </div>
</section>

<nav
  class="wrap case-study-project-nav"
  aria-label="Project navigation"
>
  <a
    href={`${base}work/${previousProject.id}/`}
    class="case-study-project-link" aria-hidden="true"
  >
    <span class="case-study-project-direction">
      ← Previous project
    </span>

<strong>{previousProject.data.title}</strong>

<small>
  {previousProject.data.category} ·
  {previousProject.data.year}
</small>
</a>

<a
href={`${base}work/${nextProject.id}/`}
class="case-study-project-link"
>

<span
  class="case-study-project-direction"
  aria-hidden="true"
>
  Next project →
</span>

<strong>{nextProject.data.title}</strong>

<small>
  {nextProject.data.category} ·
  {nextProject.data.year}
</small>

  </a>

<a href={`${base}#work`}> <span>Explore all work</span> <span aria-hidden="true">↗</span> </a>

</nav>


  </article>
</Base>
