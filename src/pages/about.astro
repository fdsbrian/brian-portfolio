---
import Base from '../layouts/BaseLayout.astro';
import about from '../data/about.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const getMediaUrl = (path: string) => {
  if (!path) return '';

  // Leave external URLs unchanged.
  const getMediaUrl = (path?: string) => {
  if (!path) {
    return '';
  }

  if (
    path.startsWith('http://') ||
    path.startsWith('https://')
  ) {
    return path;
  }

  const cleanPath = path
    .replace(/^\/brian-portfolio\//, '')
    .replace(/^\//, '');

  return `${base}${cleanPath}`;
};

  // Remove the production repository prefix if Decap saved it.
  const cleanPath = path
    .replace(/^\/brian-portfolio\//, '')
    .replace(/^\//, '');

  return `${base}${cleanPath}`;
};
---

<Base
  title="About | Brian Fernandes"
  description={about.introduction}
>
  <section class="wrap about-intro">
    <p class="eyebrow">{about.eyebrow}</p>

    <h1 class="page-title">
      {about.title}
      <br />
      <em>{about.accent}</em>
    </h1>

    <p class="about-lead">{about.introduction}</p>
  </section>

  <section class="wrap about-grid">
    <div>
      {
        about.profileImage ? (
          <figure class="profile-portrait">
            {getMediaUrl(about.profileImage)}  alt={about.profileImageAlt || 'Profile photograph'}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ) : (
          <div class="portrait">
            <span>Profile image</span>
          </div>
        )
      }
    </div>

    <div>
      <p class="body-copy about-description">
        {about.body}
      </p>

      {
  about.professionalSummary && (
    <div class="about-section-block">
      <p class="eyebrow">
        Professional Summary
      </p>

      <p class="about-summary">
        {about.professionalSummary}
      </p>
    </div>
  )
}

{
  about.designPhilosophy && (
    <div class="about-section-block">
      <p class="eyebrow">
        Design Philosophy
      </p>

      <p class="about-philosophy">
        {about.designPhilosophy}
      </p>
    </div>
  )
}

{
  about.industries?.length > 0 && (
    <div class="about-section-block">
      <p class="eyebrow">
        Industries
      </p>

      <div class="industries-grid">
        {
          about.industries.map((industry) => (
            <span class="industry-chip">
              {industry}
            </span>
          ))
        }
      </div>
    </div>
  )
}

      <h2 class="content-heading">Experience</h2>

      <div class="experience-list">
        {
          about.experience.map((item, index) => (
            <article class="experience">
              <div>
                <span class="experience-index">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <p class="experience-period">
                  {item.period}
                </p>
              </div>

              <div>
                <h3>{item.role}</h3>

                <p class="experience-company">
                  {item.company}
                  {item.location ? ` · ${item.location}` : ''}
                </p>

                <p class="body-copy">
                  {item.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap">
  <div class="section-head">
    <p class="eyebrow">Professional Summary</p>

    <div>
      <p class="about-summary">
        {about.professionalSummary}
      </p>
    </div>
  </div>
</section>

<section class="wrap">
  <div class="section-head">
    <p class="eyebrow">Design Philosophy</p>

    <div>
      <h2 class="section-title">
        Designing clarity.
        <br />
        <em>Reducing complexity.</em>
      </h2>

      <p class="body-copy about-philosophy">
        {about.designPhilosophy}
      </p>
    </div>
  </div>
</section>

<section class="wrap about-industries-section">
  <div class="section-head">
    <p class="eyebrow">Industries</p>

    <h2 class="section-title">
      Experience across
      <br />
      <em>multiple sectors.</em>
    </h2>
  </div>

  <div class="industries-grid">
    {
      about.industries?.map((industry, index) => (
        <article class="industry-chip">
          <span>
            {String(index + 1).padStart(2, '0')}
          </span>

          <strong>{industry}</strong>
        </article>
      ))
    }
  </div>
</section>

<section class="wrap achievements-section">
  <div class="section-head">
    <p class="eyebrow">Selected Achievements</p>

    <h2 class="section-title">
      Building impact through
      <br />
      <em>design leadership.</em>
    </h2>
  </div>

  <div class="achievements-grid">
    {
      about.achievements?.map((achievement, index) => (
        <article class="achievement-card">
          <span class="achievement-index">
            {String(index + 1).padStart(2, '0')}
          </span>

          <h3>{achievement.title}</h3>

          <p class="body-copy">
            {achievement.description}
          </p>
        </article>
      ))
    }
  </div>
</section>

  <section class="wrap skills-section">
    <div class="section-head">
      <p class="eyebrow">Capabilities / Tools</p>

      <h2 class="section-title">
        Experience across
        <br />
        <em>design and delivery.</em>
      </h2>
    </div>

    <div class="skills-grid">
      {
        about.skills.map((skill, index) => (
          <article
            class:list={[
              'skill-card',
              { featured: skill.featured }
            ]}
          >
            <span>
              {String(index + 1).padStart(2, '0')}
            </span>

            <small>{skill.category}</small>

            <h3>{skill.name}</h3>
          </article>
        ))
      }
    </div>
  </section>

{
  about.achievements?.length > 0 && (
    <section class="wrap achievements-section">
      <div class="section-head">
        <p class="eyebrow">
          Selected Achievements
        </p>

        <h2 class="section-title">
          Building impact
          <br />
          <em>through design.</em>
        </h2>
      </div>

      <div class="achievements-grid">
        {
          about.achievements.map(
            (achievement, index) => (
              <article class="achievement-card">
                <span class="achievement-index">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <h3>
                  {achievement.title}
                </h3>

                <p class="body-copy">
                  {achievement.description}
                </p>
              </article>
            )
          )
        }
      </div>
    </section>
  )
}

<section class="wrap about-resume-cta">
  <div class="resume-cta-card">
    <p class="eyebrow">
      Résumé
    </p>

    <h2>
      Looking for the
      <em> complete story?</em>
    </h2>

    <a href={`${base}resume/`}>
      Download Résumé →
    </a>
  </div>
</section>

</Base>