---
import Base from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort(
(a, b) => a.data.order - b.data.order
);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<Base><section class="wrap hero"><p class="eyebrow">{site.role} · {site.location}</p><h1>{site.heroLine1}<span><em>{site.heroAccent}</em> {site.heroLine2}</span></h1><div class="hero-bottom"><p>{site.heroBody}</p><a class="round-link" href="#work">View work ↗</a></div></section><section id="work" class="wrap"><div class="section-head"><p class="eyebrow">Selected work / 2025–2026</p><h2 class="section-title">Complex products.<br/><em>Clear experiences.</em></h2></div><div class="projects">{projects.map((p)=><a class="project" href={`${base}work/${p.id}/`}><div class="project-art"></div><h2>{p.data.title}</h2><p>{p.data.category} · {p.data.year}</p></a>)}</div></section><div class="marquee"><div>Design systems ✦ Product thinking ✦ Interface engineering ✦ User experience ✦ Design systems ✦ Product thinking ✦ Interface engineering ✦ User experience ✦</div></div><section class="wrap"><div class="section-head"><p class="eyebrow">About Brian</p><div><h2 class="section-title">Design precision meets <em>technical fluency.</em></h2><p class="body-copy">I work across product strategy, interface design and implementation thinking, with experience in enterprise platforms and complex workflows.</p><a href={`${base}about/`}>More about me →</a></div></div></section></Base>
